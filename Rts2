local Players = game:GetService("Players")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local DataStoreService = game:GetService("DataStoreService")
local TrackingDataStore = DataStoreService:GetDataStore("PlayerTracking")
local PlayerDataStore = DataStoreService:GetDataStore("PlayerData")
local AdminData = require(script.Parent.AdminData)
local ClanManager = require(game.ServerStorage.ServerModules.ClanManager)
local DataStore = DataStoreService:GetDataStore("GameOutcome")
local WebhookEnabled = script.Parent:FindFirstChild("WebhookEnabled")

local AdminRemote = game.ReplicatedStorage.Remotes.Private
local DiscordRequest = require(script.Parent.DiscordRequest)
local LocalizationService = game:GetService("LocalizationService")

local function getUserIdFromName(name)
	local success, result = pcall(function()
		return Players:GetUserIdFromNameAsync(name)
	end)
	if success then
		return result
	end
	return nil
end

local function getFilterData(userId)
	local success, result = pcall(function()
		return TrackingDataStore:GetAsync(userId)
	end)
	if success and result and type(result) == "table" then
		return result
	end
	return nil
end

local function setFilterData(userId, data)
	local success, err = pcall(function()
		TrackingDataStore:SetAsync(userId, data)
	end)
	return success
end

local function buildReturnData(targetName, targetUserId, isOnline, targetPlayer)
	local ReturnData = {
		Username = targetName,
		UserId = targetUserId,
		Online = isOnline,
		Stats = {},
		Class = {},
		Profile = {},
		Clan = {},
		Filter = { Active = false, Reason = "None", SetBy = "N/A", SetAt = "N/A" },
		Bounty = false,
		AccountInfo = {},
	}

	-- Get tracking data (filter + bounty)
	local trackingData = getFilterData(targetUserId)
	if trackingData then
		ReturnData.Bounty = trackingData.Bounty == true
		if trackingData.Filter then
			ReturnData.Filter.Active = trackingData.Filter.Active == true
			ReturnData.Filter.Reason = trackingData.Filter.Reason or "Not specified"
			ReturnData.Filter.SetBy = trackingData.Filter.SetBy or "Unknown"
			ReturnData.Filter.SetAt = trackingData.Filter.SetAt or "Unknown"
		end
	end

	-- Get player data from DataStore
	local success, playerData = pcall(function()
		return PlayerDataStore:GetAsync(targetUserId)
	end)

	if success and playerData then
		-- Stats
		if playerData.Stats then
			ReturnData.Stats = {
				Dinars = playerData.Stats.Dinars or 0,
				Rolls = playerData.Stats.Rolls or 0,
				Wins = playerData.Stats.Wins or 0,
				MaxHunger = playerData.Stats.MaxHunger or 100,
				MaxThirst = playerData.Stats.MaxThirst or 100,
				MaxStamina = playerData.Stats.MaxStamina or 100,
				Insurance = playerData.Stats.Insurance or 0,
				StartingMoney = playerData.Stats.StartingMoney or 20,
			}
		end

		-- Class
		if playerData.Classes then
			ReturnData.Class = {
				Equipped = playerData.Classes.ClassEquipped or "None",
				Owned = playerData.Classes.ClassesOwned or {},
				Upgrades = playerData.Classes.ClassUpgrades or {},
			}
		end

		-- Profile
		if playerData.Profile then
			ReturnData.Profile = {
				Title = playerData.Profile.Title or "NONE",
				Tag = playerData.Profile.Tag or "",
				GamesPlayed = playerData.Profile.GamesPlayed or 0,
				Wins = playerData.Profile.Wins or 0,
				WinStreak = playerData.Profile.WinStreak or 0,
				TimePlayed = playerData.Profile.TimePlayed or 0,
			}
		end
	end

	-- If player is online, get live stats (more accurate than DataStore)
	if isOnline and targetPlayer then
		local stats = targetPlayer:FindFirstChild("Stats")
		local gameStats = targetPlayer:FindFirstChild("GameStats")
		if stats then
			local d = stats:FindFirstChild("Dinars")
			if d then ReturnData.Stats.Dinars = d.Value end
			local r = stats:FindFirstChild("Rolls")
			if r then ReturnData.Stats.Rolls = r.Value end
			local w = stats:FindFirstChild("Wins")
			if w then ReturnData.Stats.Wins = w.Value end
		end
		if gameStats then
			local mh = gameStats:FindFirstChild("MaxHunger")
			if mh then ReturnData.Stats.MaxHunger = mh.Value end
			local mt = gameStats:FindFirstChild("MaxThirst")
			if mt then ReturnData.Stats.MaxThirst = mt.Value end
			local ms = gameStats:FindFirstChild("MaxStamina")
			if ms then ReturnData.Stats.MaxStamina = ms.Value end
			local ins = gameStats:FindFirstChild("Insurance")
			if ins then ReturnData.Stats.Insurance = ins.Value end
			local sm = gameStats:FindFirstChild("StartingMoney")
			if sm then ReturnData.Stats.StartingMoney = sm.Value end
		end

		-- Account info (only available for online players)
		local country = "Unknown"
		pcall(function() country = LocalizationService:GetCountryRegionForPlayerAsync(targetPlayer) end)
		ReturnData.AccountInfo = {
			AccountAge = targetPlayer.AccountAge,
			Membership = tostring(targetPlayer.MembershipType.Name),
			Country = country,
			DisplayName = targetPlayer.DisplayName,
		}
	end

	-- Clan info
	local clanResult = ClanManager.GetPlayerClan(targetUserId)
	if clanResult and clanResult.InClan and clanResult.ClanId then
		local clanInfoResult = ClanManager.GetClanInfoById(clanResult.ClanId)
		if clanInfoResult and clanInfoResult.Success then
			local memberRole = "Member"
			local clanData = ClanManager.ReturnClans()[clanResult.ClanId]
			if clanData and clanData.Members then
				local memberData = clanData.Members[targetUserId]
				if memberData then
					memberRole = memberData.Role or "Member"
				end
			end
			ReturnData.Clan = {
				InClan = true,
				ClanId = clanResult.ClanId,
				Name = clanInfoResult.Name or "?",
				Level = clanInfoResult.Level or 1,
				Role = memberRole,
				MemberCount = clanInfoResult.MemberCount or 0,
				MaxMembers = clanInfoResult.MaxMembers or 0,
				Stars = clanInfoResult.Stars or 0,
				Treasury = clanData and clanData.Treasury or 0,
			}
		end
	else
		ReturnData.Clan = { InClan = false }
	end

	return ReturnData
end

local function getPlayerByName(name)
	name = name:lower()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Name:lower() == name or plr.DisplayName:lower() == name then
			return plr
		end
	end
	return nil
end

AdminRemote.OnServerEvent:Connect(function(player, action, targetName)
	if not AdminData.IsAdmin(player) then return end
	-- if its a number
	local targetPlayer
	if not tonumber(targetName) then
		targetPlayer = targetName and getPlayerByName(targetName) or nil
	end
	
	
	if action == "Bounty" then
		if not targetPlayer then
			warn("Player not found: " .. tostring(targetName))
			return
		end
		
		-- SET the player as "on bounty" in DataStore
		local success, err = pcall(function()
			TrackingDataStore:SetAsync(targetPlayer.UserId, {Bounty = true})
		end)
		
		if success then
			print("Bounty set for " .. targetPlayer.Name)
			AdminRemote:FireClient(player, "BountySet", targetPlayer.Name)
			
			-- Notify ALL servers to kick this player
			MessagingService:PublishAsync("BountySet", {UserId = targetPlayer.UserId, Name = targetPlayer.Name})
		else
			warn("Failed to set bounty: " .. tostring(err))
		end
	
	elseif action == "Remove" then
		if not targetPlayer then
			warn("Player not found: " .. tostring(targetName))
			return
		end
		
		-- REMOVE bounty from player
		local success, err = pcall(function()
			TrackingDataStore:SetAsync(targetPlayer.UserId, {Bounty = false})
		end)
		
		if success then
			print("Bounty removed for " .. targetPlayer.Name)
			AdminRemote:FireClient(player, "BountyRemoved", targetPlayer.Name)
			
			-- Notify ALL servers that bounty is removed
			MessagingService:PublishAsync("BountyRemoved", {UserId = targetPlayer.UserId, Name = targetPlayer.Name})
		else
			warn("Failed to remove bounty: " .. tostring(err))
		end
	
	elseif action == "Kick" then
		if targetPlayer then
			targetPlayer:Kick("You have been kicked by an admin.")
		else
			warn("Player not found: " .. tostring(targetName))
		end
	
	elseif action == "Op" then
		if not targetPlayer then
			warn("Player not found: " .. tostring(targetName))
			return
		end
		
		-- Add player as admin (SERVER-SIDE ONLY)
		AdminData.AddAdmin(targetPlayer.UserId)
		print(targetPlayer.Name .. " is now an admin (UserId: " .. targetPlayer.UserId .. ")")
		AdminRemote:FireClient(player, "OpSuccess", targetPlayer.Name)
	
	elseif action == "Extract" then
		local targetUserId
		local targetDisplayName = targetName
		local isOnline = false
		local playerData = nil
		
		-- Check if player is online
		if targetPlayer then
			isOnline = true
			targetUserId = targetPlayer.UserId
			targetDisplayName = targetPlayer.DisplayName
			
			-- Get real-time stats from online player
			local stats = targetPlayer:FindFirstChild("Stats")
			local gameStats = targetPlayer:FindFirstChild("GameStats")
			
			if stats and gameStats then
				playerData = {
					Dinars = stats:FindFirstChild("Dinars") and stats.Dinars.Value or 0,
					MaxHunger = gameStats:FindFirstChild("MaxHunger") and gameStats.MaxHunger.Value or 100,
					MaxThirst = gameStats:FindFirstChild("MaxThirst") and gameStats.MaxThirst.Value or 100,
					MaxStamina = gameStats:FindFirstChild("MaxStamina") and gameStats.MaxStamina.Value or 100,
					Insurance = gameStats:FindFirstChild("Insurance") and gameStats.Insurance.Value or 1,
					StartingMoney = gameStats:FindFirstChild("StartingMoney") and gameStats.StartingMoney.Value or 20,
				}
			end
		else
			-- Player is offline, try to get UserId from name
			targetUserId = getUserIdFromName(targetName)
			
			if targetUserId then
				-- Get data from PlayerDataStore
				local success, data = pcall(function()
					return PlayerDataStore:GetAsync(targetUserId)
				end)
				
				if success and data then
					playerData = data
					targetDisplayName = targetName
				end
			end
		end
		
		-- Get clan info for this player
		local clanInfoStr = "No Clan"
		if targetUserId then
			local clanResult = ClanManager.GetPlayerClan(targetUserId)
			if clanResult and clanResult.InClan and clanResult.ClanId then
				local clanInfoResult = ClanManager.GetClanInfoById(clanResult.ClanId)
				if clanInfoResult and clanInfoResult.Success then
					local memberRole = "Member"
					local clanData = ClanManager.ReturnClans()[clanResult.ClanId]
					if clanData and clanData.Members then
						local memberData = clanData.Members[targetUserId]
						if memberData then
							memberRole = memberData.Role or "Member"
						end
					end
					clanInfoStr = "Name: " .. (clanInfoResult.Name or "?") ..
						" | Level: " .. (clanInfoResult.Level or 1) ..
						" | Role: " .. memberRole ..
						" | Members: " .. (clanInfoResult.MemberCount or 0) .. "/" .. (clanInfoResult.MaxMembers or 0) ..
						" | Stars: " .. (clanInfoResult.Stars or 0) ..
						" | Treasury: " .. (clanData and clanData.Treasury or 0)
				else
					clanInfoStr = "Clan ID: " .. clanResult.ClanId .. " (data unavailable)"
				end
			end
		end

		-- Build Discord embed
		local embedData
		
		if playerData then
			embedData = {
				["title"] = "** Player Stats Extract **",
				["description"] = "Stats extracted for **" .. targetDisplayName .. "**",
				["color"] = 3447003,
				["thumbnail"] = {
					["url"] = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. targetUserId .. "&width=420&height=420&format=png"
				},
				["fields"] = {
					{
						["name"] = "** Player Info **",
						["value"] = "**Name:** " .. targetDisplayName .. "\n**UserId:** " .. targetUserId .. "\n**Status:** " .. (isOnline and "Online" or "Offline"),
						["inline"] = false
					},
					{
						["name"] = "** Game Stats **",
						["value"] = "```js\nDinars: " .. (playerData.Dinars or 0) .. "\nInsurance: " .. (playerData.Insurance or 1) .. "\nMaxStamina: " .. (playerData.MaxStamina or 100) .. "\nMaxHunger: " .. (playerData.MaxHunger or 100) .. "\nMaxThirst: " .. (playerData.MaxThirst or 100) .. "\nStartingMoney: " .. (playerData.StartingMoney or 20) .. "\n```",
						["inline"] = false
					},
					{
						["name"] = "** Clan Info **",
						["value"] = "```fix\n" .. clanInfoStr .. "\n```",
						["inline"] = false
					}
				},
				["footer"] = {
					["text"] = "Extracted by " .. player.Name .. " • " .. os.date("%Y-%m-%d %H:%M:%S")
				}
			}
		else
			embedData = {
				["title"] = "** Player Stats Extract **",
				["description"] = "No data found for **" .. targetName .. "**",
				["color"] = 16711680,
				["fields"] = {
					{
						["name"] = "** Result **",
						["value"] = "This player has never played the game or no data exists.",
						["inline"] = false
					}
				},
				["footer"] = {
					["text"] = "Extracted by " .. player.Name .. " • " .. os.date("%Y-%m-%d %H:%M:%S")
				}
			}
		end
		
		-- Send to Discord (respect WebhookEnabled toggle)
		if WebhookEnabled and WebhookEnabled.Value then
			local data = {
				["embeds"] = {embedData}
			}
			
			local success = DiscordRequest.SendWebhook(data)
			
			if success then
				print("Stats extracted and sent to Discord for " .. targetName)
				AdminRemote:FireClient(player, "ExtractSuccess", targetName)
			else
				warn("Failed to send to Discord: " .. tostring(err))
			end
		else
			print("[Webhook] Skipped extract webhook (WebhookEnabled = false)")
			AdminRemote:FireClient(player, "ExtractSuccess", targetName)
		end
	
	elseif action == "Filter" then
		if not targetName or targetName == "" then
			warn("[Filter] No target name provided")
			return
		end

		-- Resolve target (online or offline)
		local filterTargetId
		local filterTargetName = targetName

		if targetPlayer then
			filterTargetId = targetPlayer.UserId
			filterTargetName = targetPlayer.Name
		else
			filterTargetId = getUserIdFromName(targetName)
			if not filterTargetId then
				warn("[Filter] Could not find UserId for: " .. targetName)
				AdminRemote:FireClient(player, "FilterError", "Player not found")
				return
			end
		end

		-- Get current tracking data
		local currentData = getFilterData(filterTargetId) or {}

		-- Toggle filter
		if currentData.Filter and currentData.Filter.Active then
			-- Remove from filter
			currentData.Filter = { Active = false, Reason = "None", SetBy = "N/A", SetAt = "N/A" }
			local ok = setFilterData(filterTargetId, currentData)
			if ok then
				print("[Filter] Removed filter for " .. filterTargetName)
				AdminRemote:FireClient(player, "FilterRemoved", filterTargetName)

				-- Notify other servers
				MessagingService:PublishAsync("FilterRemoved", { UserId = filterTargetId, Name = filterTargetName })
			else
				warn("[Filter] Failed to remove filter for " .. filterTargetName)
			end
		else
			-- Add to filter
			currentData.Filter = {
				Active = true,
				Reason = "Suspected cheating",
				SetBy = player.Name,
				SetAt = os.date("%Y-%m-%d %H:%M:%S"),
			}
			local ok = setFilterData(filterTargetId, currentData)
			if ok then
				print("[Filter] Added filter for " .. filterTargetName)
				AdminRemote:FireClient(player, "FilterSet", filterTargetName)

				-- Notify other servers
				MessagingService:PublishAsync("FilterSet", { UserId = filterTargetId, Name = filterTargetName })
			else
				warn("[Filter] Failed to set filter for " .. filterTargetName)
			end
		end

	elseif action == "Lookup" then
		if not targetName or targetName == "" then
			warn("[Lookup] No target name provided")
			return
		end

		-- Resolve target (online or offline)
		local lookupTargetId
		local lookupTargetName = targetName
		local lookupIsOnline = false
		local lookupTargetPlayer = nil

		if targetPlayer then
			lookupTargetId = targetPlayer.UserId
			lookupTargetName = targetPlayer.Name
			lookupIsOnline = true
			lookupTargetPlayer = targetPlayer
		else
			lookupTargetId = getUserIdFromName(targetName)
			if not lookupTargetId then
				warn("[Lookup] Could not find UserId for: " .. targetName)
				AdminRemote:FireClient(player, "LookupError", "Player not found")
				return
			end
		end

		-- Build full return data
		local ReturnData = buildReturnData(lookupTargetName, lookupTargetId, lookupIsOnline, lookupTargetPlayer)

		-- Send back to admin client
		AdminRemote:FireClient(player, "LookupResult", HttpService:JSONEncode(ReturnData))

		-- Also send to Discord as embed
		local filterStatus = ReturnData.Filter.Active and "ACTIVE" or "Inactive"
		local filterColor = ReturnData.Filter.Active and 16711680 or 5763719

		local statsStr = "Dinars: " .. ReturnData.Stats.Dinars ..
			" | Rolls: " .. ReturnData.Stats.Rolls..
			" | Wins: " .. ReturnData.Stats.Wins..
			"\nMaxHunger: " .. ReturnData.Stats.MaxHunger..
			" | MaxThirst: " .. ReturnData.Stats.MaxThirst..
			" | MaxStamina: " .. ReturnData.Stats.MaxStamina..
			"\nInsurance: " .. ReturnData.Stats.Insurance..
			" | StartingMoney: " .. ReturnData.Stats.StartingMoney

		local classStr = "Equipped: " .. ReturnData.Class.Equipped
		if ReturnData.Class.Equipped ~= "None" then
			local lvl = ReturnData.Class.Upgrades[ReturnData.Class.Equipped] or 0
			classStr = classStr .. " (Lv." .. lvl .. ")"
			local ownedCount = 0
			for _ in pairs(ReturnData.Class.Owned) do ownedCount = ownedCount + 1 end
			classStr = classStr .. "\nOwned: " .. ownedCount .. " classes"
		end

		local clanStr = "No Clan"
		if ReturnData.Clan.InClan then
			clanStr = ReturnData.Clan.Name ..
				" | Level: " .. ReturnData.Clan.Level..
			" | Role: " .. ReturnData.Clan.Role..
			"\ Members: " .. ReturnData.Clan.MemberCount .. "/" .. ReturnData.Clan.MaxMembers..
			" | Stars: " .. ReturnData.Clan.Stars..
			" | Treasury: " .. ReturnData.Clan.Treasury
		end

		local profileStr = "Title: " .. ReturnData.Profile.Title..
			" | Tag: " .. (ReturnData.Profile.Tag or "")..
			"\nGames: " .. ReturnData.Profile.GamesPlayed..
			" | Wins: " .. ReturnData.Profile.Wins..
			" | Time: " .. ReturnData.Profile.TimePlayed .. "s"

		local filterStr = "Status: " .. filterStatus
		if ReturnData.Filter.Active then
			filterStr = filterStr .. "\nReason: " .. ReturnData.Filter.Reason..
				"\nSet By: " .. ReturnData.Filter.SetBy..
				"\nSet At: " .. ReturnData.Filter.SetAt
		end

		local embedData = {
			["title"] = "** Player Lookup **",
			["description"] = "Full data for **" .. lookupTargetName .. "** (" .. (lookupIsOnline and "Online" or "Offline") .. ")",
			["color"] = filterColor,
			["thumbnail"] = {
				["url"] = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. lookupTargetId .. "&width=420&height=420&format=png"
			},
			["fields"] = {
				{
					["name"] = "** Player Info **",
					["value"] = "**Name:** " .. lookupTargetName .. "\n**UserId:** " .. lookupTargetId .. "\n**Bounty:** " .. tostring(ReturnData.Bounty),
					["inline"] = false
				},
				{
					["name"] = "** Game Stats **",
					["value"] = "```js\n" .. statsStr .. "\n```",
					["inline"] = false
				},
				{
					["name"] = "** Class **",
					["value"] = "```fix\n" .. classStr .. "\n```",
					["inline"] = false
				},
				{
					["name"] = "** Clan **",
					["value"] = "```fix\n" .. clanStr .. "\n```",
					["inline"] = false
				},
				{
					["name"] = "** Profile **",
					["value"] = "```fix\n" .. profileStr .. "\n```",
					["inline"] = false
				},
				{
					["name"] = "** Filter Status **",
					["value"] = "```diff\n" .. filterStr .. "\n```",
					["inline"] = false
				},
			},
			["footer"] = {
				["text"] = "Looked up by " .. player.Name .. " • " .. os.date("%Y-%m-%d %H:%M:%S")
			}
		}

		if WebhookEnabled and WebhookEnabled.Value then
			local data = { ["embeds"] = {embedData} }
			DiscordRequest.SendWebhook(data)
		end

	elseif action == "Webhook" then
		if not WebhookEnabled then
			warn("WebhookEnabled BoolValue not found")
			return
		end
		WebhookEnabled.Value = not WebhookEnabled.Value
		local state = WebhookEnabled.Value and "ON" or "OFF"
		print("[Webhook] Toggled to " .. state)
		AdminRemote:FireClient(player, "WebhookToggled", state)

	elseif action == "SChat" then
		-- targetName is the message here
		local message = targetName
		
		if not message or message == "" then
			warn("No message provided")
			return
		end
		
		print("[SERVER CHAT] " .. player.Name .. ": " .. message)
		
		-- Publish to ALL servers (including this one) via MessagingService
		MessagingService:PublishAsync("ServerChat", {
			AdminName = player.Name,
			Message = message
		})
		
		AdminRemote:FireClient(player, "SChatSuccess", message)
	elseif action == "RateCh" then
		local targetAmount = tonumber(targetName)
		local MaxHard = 50
		local Relief = 2 
		if not targetAmount then
			warn("Invalid rate amount")
			return
		end
		if targetAmount > MaxHard then
			warn("Rate too high")
			return
		end
		if targetAmount < Relief then
			warn("Rate too low")
			return
		end
		-- Update the global rate
		local Rate = targetAmount
		print("Rate set to " .. Rate)
		local Success, Error = pcall(function()
			DataStore:UpdateAsync("Global_Settings",function(old)
				old = old or {}
				old.ConversationRate = targetAmount
				print("Rate :"..tostring(old.ConversationRate))
				return old
			end)
		end)
		if Success then
			print("Rate updated successfully")
		else
			warn("Failed to update rate: " .. tostring(Error))
		end
	end
end)
