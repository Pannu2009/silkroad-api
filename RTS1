local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalizationService = game:GetService("LocalizationService")
local MessagingService = game:GetService("MessagingService")

local DiscordRequest = require(script.Parent.DiscordRequest)
local WebhookEnabled = script.Parent:FindFirstChild("WebhookEnabled")

local TrackingDataStore = game:GetService("DataStoreService"):GetDataStore("PlayerTracking")


MessagingService:SubscribeAsync("BountySet", function(message)
	local data = message.Data
	local targetUserId = data.UserId
	
	-- Check if this player is in our server
	for _, player in ipairs(Players:GetPlayers()) do
		if player.UserId == targetUserId then
			print("Cross-server bounty kick for " .. player.Name)
			task.delay(1, function()
				if player and player.Parent then
					player:Kick("You Have Gotten A Bounty! Ask Admin on Discord for Reason or Appeal")
				end
			end)
			break
		end
	end
end)

MessagingService:SubscribeAsync("BountyRemoved", function(message)
	local data = message.Data
	local targetUserId = data.UserId
	print("Bounty removed for UserId: " .. targetUserId)
end)

MessagingService:SubscribeAsync("FilterSet", function(message)
	local data = message.Data
	local targetUserId = data.UserId
	print("[Filter] Cross-server filter set for UserId: " .. targetUserId)
end)

MessagingService:SubscribeAsync("FilterRemoved", function(message)
	local data = message.Data
	local targetUserId = data.UserId
	print("[Filter] Cross-server filter removed for UserId: " .. targetUserId)
end)

MessagingService:SubscribeAsync("ServerChat", function(message)
	local data = message.Data
	local adminName = data.AdminName
	local chatMessage = data.Message
	
	print("[SERVER CHAT] " .. adminName .. ": " .. chatMessage)
	
	local ServerChatRemote = game.ReplicatedStorage:FindFirstChild("Remotes") and game.ReplicatedStorage.Remotes:FindFirstChild("ServerChat")
	if ServerChatRemote then
		for _, player in ipairs(Players:GetPlayers()) do
			ServerChatRemote:FireClient(player, adminName, chatMessage)
		end
	end
end)

local function getTrackingData(player)
	local success, result = pcall(function()
		return TrackingDataStore:GetAsync(player.UserId)
	end)
	if not success then
		warn("Failed to get tracking data for " .. player.Name .. ": " .. tostring(result))
		return false
	end
	if result and type(result) == "table" and result.Bounty == true then
		return true
	end
	return false
end


local function getFriendsList(player)
	local friends = {}
	local success, result = pcall(function()
		return Players:GetFriendsAsync(player.UserId)
	end)

	if success then
		local count = 0
		for _, item in ipairs(result:GetCurrentPage()) do
			count += 1
			if count <= 10 then
				table.insert(friends, item.Username)
			else
				break
			end
		end
		local text = table.concat(friends, ", ")
		return #friends >= 10 and text .. "... (+25)" or text
	end
	return "Private or Error"
end

